      "cell_type": "code",
      "source": [
        "import torch\n",
        "import torch.nn as nn\n",
        "import torchvision.models as models"
      ],
      "metadata": {
        "id": "lw3di0bgolQ1"
      },
      "id": "lw3di0bgolQ1",
      "execution_count": 1,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "class HairNet(nn.Module):\n",
        "    def __init__(self):\n",
        "        super().__init__()\n",
        "\n",
        "        base = models.resnet18(pretrained=True)\n",
        "        self.backbone = nn.Sequential(*list(base.children())[:-1])\n",
        "\n",
        "        self.curl = nn.Linear(512, 3)\n",
        "        self.thickness = nn.Linear(512, 3)\n",
        "        self.density = nn.Linear(512, 4)\n",
        "        self.part_pos = nn.Linear(512, 5)\n",
        "        self.part_shape = nn.Linear(512, 3)\n",
        "\n",
        "    def forward(self, x):\n",
        "        x = self.backbone(x)\n",
        "        x = x.view(x.size(0), -1)\n",
        "\n",
        "        return {\n",
        "            \"curl\": self.curl(x),\n",
        "            \"thickness\": self.thickness(x),\n",
        "            \"density\": self.density(x),\n",
        "            \"part_pos\": self.part_pos(x),\n",
        "            \"part_shape\": self.part_shape(x),\n",
        "        }"
      ],
      "metadata": {
        "id": "cVzRi7ogHuI9"
      },
      "id": "cVzRi7ogHuI9",
      "execution_count": 2,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "import os\n",
        "import cv2\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "from tqdm import tqdm\n",
        "import torch\n",
        "import torch.nn as nn\n",
        "import torch.nn.functional as F\n",
        "\n",
        "IMAGE_DIR = \"training\"\n",
        "IMG_SIZE = 128\n",
        "\n",
        "# -----------------------------\n",
        "# 1. улучшенная сегментация волос\n",
        "# -----------------------------\n",
        "def get_hair_mask(img):\n",
        "    gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)\n",
        "\n",
        "    # адаптивный порог (лучше чем fixed 80)\n",
        "    mask = cv2.adaptiveThreshold(\n",
        "        gray, 255,\n",
        "        cv2.ADAPTIVE_THRESH_GAUSSIAN_C,\n",
        "        cv2.THRESH_BINARY_INV,\n",
        "        35, 7\n",
        "    )\n",
        "\n",
        "    kernel = np.ones((5,5), np.uint8)\n",
        "    mask = cv2.morphologyEx(mask, cv2.MORPH_CLOSE, kernel, iterations=2)\n",
        "\n",
        "    return mask\n",
        "\n",
        "# -----------------------------\n",
        "# 2. HoughLinesP → пробор\n",
        "# -----------------------------\n",
        "def get_part_position_hough(mask):\n",
        "    edges = cv2.Canny(mask, 50, 150)\n",
        "\n",
        "    lines = cv2.HoughLinesP(\n",
        "        edges,\n",
        "        1,\n",
        "        np.pi/180,\n",
        "        threshold=80,\n",
        "        minLineLength=40,\n",
        "        maxLineGap=10\n",
        "    )\n",
        "\n",
        "    if lines is None:\n",
        "        return 3  # fallback центр\n",
        "\n",
        "    h, w = mask.shape\n",
        "    best_x = []\n",
        "\n",
        "    for line in lines:\n",
        "        x1, y1, x2, y2 = line[0]\n",
        "\n",
        "        # ищем вертикальные/почти вертикальные линии (пробор)\n",
        "        if abs(x1 - x2) < 20:\n",
        "            best_x.append((x1 + x2) // 2)\n",
        "\n",
        "    if len(best_x) == 0:\n",
        "        return 3\n",
        "\n",
        "    part_x = int(np.median(best_x))\n",
        "\n",
        "    # нормализация 1..5 зон\n",
        "    zone = int((part_x / w) * 5) + 1\n",
        "    return max(1, min(5, zone))\n",
        "\n",
        "# -----------------------------\n",
        "# 3. форма пробора (через Hough)\n",
        "# -----------------------------\n",
        "def get_part_shape_hough(mask):\n",
        "    edges = cv2.Canny(mask, 50, 150)\n",
        "\n",
        "    lines = cv2.HoughLinesP(edges, 1, np.pi/180, 80, minLineLength=50, maxLineGap=10)\n",
        "\n",
        "    if lines is None:\n",
        "        return \"unknown\"\n",
        "\n",
        "    angles = []\n",
        "    for l in lines:\n",
        "        x1, y1, x2, y2 = l[0]\n",
        "        angle = np.degrees(np.arctan2(y2 - y1, x2 - x1))\n",
        "        angles.append(angle)\n",
        "\n",
        "    angles = np.array(angles)\n",
        "\n",
        "    std = np.std(angles)\n",
        "    mean = np.mean(angles)\n",
        "\n",
        "    if std < 5:\n",
        "        return \"straight\"\n",
        "    elif mean > 20:\n",
        "        return \"diagonal\"\n",
        "    else:\n",
        "        return \"curved\"\n",
        "\n",
        "# -----------------------------\n",
        "# 4. CNN для типа волос\n",
        "# -----------------------------\n",
        "class HairCNN(nn.Module):\n",
        "    def __init__(self):\n",
        "        super().__init__()\n",
        "\n",
        "        self.conv = nn.Sequential(\n",
        "            nn.Conv2d(1, 16, 3, 1, 1),\n",
        "            nn.ReLU(),\n",
        "            nn.MaxPool2d(2),\n",
        "\n",
        "            nn.Conv2d(16, 32, 3, 1, 1),\n",
        "            nn.ReLU(),\n",
        "            nn.MaxPool2d(2),\n",
        "\n",
        "            nn.Conv2d(32, 64, 3, 1, 1),\n",
        "            nn.ReLU(),\n",
        "            nn.AdaptiveAvgPool2d(1)\n",
        "        )\n",
        "\n",
        "        self.fc = nn.Linear(64, 3)  # straight / wavy / curly\n",
        "\n",
        "    def forward(self, x):\n",
        "        x = self.conv(x)\n",
        "        x = x.view(x.size(0), -1)\n",
        "        return self.fc(x)\n",
        "\n",
        "model = HairCNN()\n",
        "model.eval()\n",
        "\n",
        "HAIR_CLASSES = [\"straight\", \"wavy\", \"curly\"]\n",
        "\n",
        "def get_curl_type_cnn(mask):\n",
        "    img = cv2.resize(mask, (IMG_SIZE, IMG_SIZE))\n",
        "    tensor = torch.tensor(img, dtype=torch.float32).unsqueeze(0).unsqueeze(0) / 255.0\n",
        "\n",
        "    with torch.no_grad():\n",
        "        out = model(tensor)\n",
        "        pred = torch.argmax(out, dim=1).item()\n",
        "\n",
        "    return HAIR_CLASSES[pred]\n",
        "\n",
        "# -----------------------------\n",
        "# 5. густота (улучшенная)\n",
        "# -----------------------------\n",
        "def get_density(mask):\n",
        "    ratio = np.mean(mask > 0)\n",
        "\n",
        "    if ratio < 0.15:\n",
        "        return \"balding\"\n",
        "    elif ratio < 0.35:\n",
        "        return \"sparse\"\n",
        "    elif ratio < 0.6:\n",
        "        return \"medium\"\n",
        "    else:\n",
        "        return \"dense\"\n",
        "\n",
        "# -----------------------------\n",
        "# 6. толщина (через edge density)\n",
        "# -----------------------------\n",
        "def get_thickness(mask):\n",
        "    edges = cv2.Canny(mask, 50, 150)\n",
        "    val = np.mean(edges > 0)\n",
        "\n",
        "    if val > 0.08:\n",
        "        return \"thin\"\n",
        "    elif val > 0.04:\n",
        "        return \"medium\"\n",
        "    else:\n",
        "        return \"thick\"\n",
        "\n",
        "# -----------------------------\n",
        "# 7. основной цикл\n",
        "# -----------------------------\n",
        "data = []\n",
        "\n",
        "files = [f for f in os.listdir(IMAGE_DIR) if f.endswith(\".jpg\")]\n",
        "\n",
        "for file in tqdm(files):\n",
        "    path = os.path.join(IMAGE_DIR, file)\n",
        "\n",
        "    img = cv2.imread(path)\n",
        "    img = cv2.resize(img, (256, 256))\n",
        "\n",
        "    mask = get_hair_mask(img)\n",
        "\n",
        "    density = get_density(mask)\n",
        "    part_pos = get_part_position_hough(mask)\n",
        "    part_shape = get_part_shape_hough(mask)\n",
        "    curl = get_curl_type_cnn(mask)\n",
        "    thickness = get_thickness(mask)\n",
        "\n",
        "    data.append([\n",
        "        file,\n",
        "        curl,\n",
        "        thickness,\n",
        "        density,\n",
        "        part_pos,\n",
        "        part_shape\n",
        "    ])\n",
        "\n",
        "# -----------------------------\n",
        "# 8. сохранение\n",
        "# -----------------------------\n",
        "df = pd.DataFrame(data, columns=[\n",
        "    \"image\",\n",
        "    \"curl_type\",\n",
        "    \"thickness\",\n",
        "    \"density\",\n",
        "    \"part_position\",\n",
        "    \"part_shape\"\n",
        "])\n",
        "\n",
        "df.to_csv(\"auto_dataset1.csv\", index=False)\n",
        "\n",
        "print(\"✅ CSV создан: auto_dataset.csv\")"
      ],
